{
    "mcpServers": {
        "audio": {
            "type": "stdio",
            "command": "python",
            "args": [
                "-m",
                "mas_arena.mcp_collections.media.audio"
            ],
            "env": {},
            "client_session_timeout_seconds": 10.0
        },
