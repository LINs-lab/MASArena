#===============================================================================
# MAS Arena — Environment Variables
#===============================================================================
# cp .env.example .env   (auto-loaded by run_benchmark.sh and main.py)
#===============================================================================

#------------------------------------------------------------------------------
# LLM API (required)
#------------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=                          # override for vLLM / LiteLLM / etc.
OPENAI_API_TIMEOUT=300
MODEL_NAME=gpt-4o-mini
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# HuggingFace (dataset downloads)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#------------------------------------------------------------------------------
# Search & Crawler
#------------------------------------------------------------------------------
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEB_SEARCH_PROVIDER=jina                   # jina (default) | tavily
WEB_SEARCH_ALLOW_TAVILY_FALLBACK=false
SEARCH_JINA_TIMEOUT=30
CRAWLER_CONNECT_TIMEOUT=5
CRAWLER_READ_TIMEOUT=10
CRAWLER_TOTAL_TIMEOUT=20
CRAWLER_SIMPLE_MAX_BYTES=400000
CRAWLER_JINA_MAX_BYTES=1200000
CRAWLER_JINA_TOTAL_TIMEOUT=25

#------------------------------------------------------------------------------
# Browser (Playwright)
#------------------------------------------------------------------------------
MAS_ARENA_BROWSER_POOL_SIZE=4
MAS_ARENA_BROWSER_ACQUIRE_TIMEOUT_SECONDS=300
MAS_ARENA_BROWSER_GOTO_TIMEOUT_MS=20000
MAS_ARENA_BROWSER_EVALUATE_TIMEOUT_MS=15000
MAS_ARENA_BROWSER_SCREENSHOT_TIMEOUT_MS=30000
MAS_ARENA_BROWSER_TIMEOUT_SECONDS=120
MAS_ARENA_AUTO_INSTALL_PLAYWRIGHT=false
# OPENAI_API_KEY_BROWSER=                  # separate LLM creds for browser agent
# OPENAI_API_BASE_BROWSER=
# CHATGPT_MODEL=

# Audio / Vision
# AUDIO_LLM_API_KEY=
# AUDIO_LLM_BASE_URL=

#------------------------------------------------------------------------------
# Memory & RL (experimental)
#------------------------------------------------------------------------------
MELO_DEBUG=false
MELO_DEBUG_MAXLEN=500
RL_MELO_PERSIST_DIR=mas_arena/train/persist/melo
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SUCCESSFUL_TOPK=4
FAILED_TOPK=2
INSIGHTS_TOPK=3
THRESHOLD=0.3
SEARCH_AGENT_PLANNING_INTERVAL=0
MANAGE_AGENT_PLANNING_INTERVAL=0

# Misc
MAS_ARENA_SILENCE_HTTP_LOGS=true
DEBUG=false
